# Copy file nay thanh .env va dien gia tri that vao

# API key Arkham (Settings / API trong tai khoan Arkham cua ban)
ARKHAM_API_KEY=

# Token bot Telegram (lay tu @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat ID nhan canh bao (chat voi bot cua ban, hoac dung @userinfobot de lay ID)
TELEGRAM_CHAT_ID=

# --- Tuy chinh (co the bo qua de dung mac dinh) ---

# Danh sach token ID (CoinGecko-style, VD "bitcoin", "power-protocol") cach
# nhau boi dau phay. Neu dien: bot CHI quet dung cac token nay, bo qua toan
# bo pham vi thi truong va bo qua bo loc market cap. De trong = quet toan bo.
WATCHLIST=

# Khung thoi gian xet dong tien: 1h | 6h | 12h | 24h | 7d
TIMEFRAME=1h

# Loai token nam trong Top N theo Market Cap (tu dong lay du lieu that tu
# CoinGecko, cap nhat moi gio) - dat 0 de tat, dung MAX_MARKET_CAP thu cong.
EXCLUDE_TOP_RANK=100

# Nguong Market Cap (USD) du phong - chi dung khi EXCLUDE_TOP_RANK=0 hoac
# khong goi duoc CoinGecko (mat mang...).
MAX_MARKET_CAP=3000000000

# DIEU KIEN CHINH: ty le tang toi thieu so voi ky truoc de coi la dot bien.
# 0.5 = phai tang >= 50% so voi cung khung gio ky truoc moi bi canh bao.
MIN_SURGE_RATIO=0.5

# Nguong USD du phong - chi dung khi token MOI xuat hien, chua co du lieu ky truoc
MIN_USD_THRESHOLD=50000

# Nguong ty le (dong tien / market cap) du phong, 0.015 = 1.5%
MIN_MCAP_RATIO=0.015

# So token top dau lay ve moi lan quet (theo inflow va theo outflow)
TOP_N=30

# Khoang cach giua cac lan quet (giay)
POLL_INTERVAL_SECONDS=180

# Khong canh bao lap lai cho cung 1 token trong X giay
ALERT_COOLDOWN_SECONDS=3600
